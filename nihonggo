<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>高考日语听力训练器</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pako/2.1.0/pako.min.js"></script>
<style>
  * { box-sizing: border-box; }
  :root{
    --bg:#0f172a; --panel:#1b2537; --panel2:#243149; --line:#334155;
    --text:#e2e8f0; --muted:#94a3b8; --accent:#38bdf8;
  }
  html,body{height:100%;margin:0}
  body{
    background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column;
    font-family:"PingFang SC","Microsoft YaHei",system-ui,-apple-system,sans-serif;font-size:14px;
  }
  header{
    display:flex;align-items:center;gap:8px;padding:10px 14px;flex-wrap:wrap;
    background:var(--panel);border-bottom:1px solid var(--line);
  }
  header h1{font-size:15px;margin:0 10px 0 0;white-space:nowrap}
  .btn{
    background:var(--panel2);color:var(--text);border:1px solid var(--line);
    padding:6px 12px;border-radius:6px;cursor:pointer;font-size:13px;
    transition:.15s;user-select:none;white-space:nowrap;
  }
  .btn:hover{background:#334155}
  .btn.active{background:var(--accent);color:#0b1220;border-color:var(--accent);font-weight:600}
  .btn.primary{background:#0ea5e9;border-color:#0ea5e9;color:#0b1220;font-weight:600}
  .btn.primary:hover{background:#38bdf8}
  .btn.danger{background:#dc2626;border-color:#dc2626;color:#fff}
  .btn.danger:hover{background:#ef4444}
  .btn.tiny{padding:3px 8px;font-size:12px}
  .btn.speed{padding:5px 12px;font-size:12.5px}
  .btn.jump{padding:5px 10px;font-size:12.5px}
  .btn:disabled{opacity:.4;cursor:not-allowed}
  .btn:disabled:hover{background:var(--panel2)}
  .muted{color:var(--muted);font-size:12px}
  .hw-select{
    background:var(--panel2);border:1px solid var(--line);color:var(--text);
    padding:6px 10px;border-radius:6px;font-size:13px;outline:none;
    min-width:150px;max-width:240px;
  }
  .hw-select:focus{border-color:var(--accent)}

  #readonlyBanner{
    display:none;
    background:linear-gradient(90deg,#0ea5e9,#38bdf8);
    color:#0b1220;
    padding:8px 16px;
    font-size:13px;
    font-weight:600;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    flex-wrap:wrap;
  }
  #readonlyBanner.show{display:flex}
  #readonlyBanner .btn{
    background:rgba(0,0,0,.2);color:#fff;border-color:transparent;
    padding:4px 10px;font-size:12px;
  }
  #readonlyBanner .btn:hover{background:rgba(0,0,0,.35)}

  main{flex:1;display:flex;overflow:hidden}

  #inputView{
    flex:1;display:flex;flex-direction:column;padding:16px;gap:12px;overflow:hidden;
  }
  #inputView .hint{
    background:rgba(56,189,248,.08);
    border:1px dashed rgba(56,189,248,.35);
    border-radius:8px;padding:10px 14px;font-size:12.5px;color:#bae6fd;line-height:1.8;
  }
  #inputView .hint b{color:#7dd3fc}
  #sourceInput{
    flex:1;min-height:200px;resize:none;background:var(--panel2);
    border:1px solid var(--line);color:var(--text);padding:14px 16px;
    border-radius:8px;font-size:14.5px;line-height:1.9;font-family:inherit;
    outline:none;transition:border-color .15s;
  }
  #sourceInput:focus{border-color:var(--accent)}
  #sourceInput.dragover{border-color:var(--accent);background:rgba(56,189,248,.06)}

  #questionView{flex:1;display:none;overflow:hidden}
  #questionView.active{display:flex}

  .sidebar{
    width:240px;flex-shrink:0;background:var(--panel);
    border-right:1px solid var(--line);
    display:flex;flex-direction:column;overflow:hidden;
  }
  .sidebar-head{
    padding:10px 14px;border-bottom:1px solid var(--line);
    font-size:12px;color:var(--muted);
    display:flex;justify-content:space-between;align-items:center;
    cursor:pointer;transition:background .15s;user-select:none;
  }
  .sidebar-head:hover{background:var(--panel2);color:var(--text)}
  .sidebar-head.no-back{cursor:default}
  .sidebar-head.no-back:hover{background:transparent;color:var(--muted)}
  .sidebar-head .sb-title{display:flex;align-items:center;gap:6px}
  .sidebar-head .sb-back{opacity:.7;font-size:14px}
  .sidebar-head:hover .sb-back{opacity:1}
  #questionList{list-style:none;margin:0;padding:6px;overflow-y:auto;flex:1}
  #questionList .q-item{
    padding:10px 12px;border-radius:6px;cursor:pointer;margin-bottom:3px;
    font-size:13.5px;transition:.12s;user-select:none;line-height:1.4;
  }
  #questionList .q-item:hover{background:var(--panel2)}
  #questionList .q-item.active{background:var(--accent);color:#0b1220;font-weight:600}
  #questionList .q-item .q-line{display:flex;align-items:center;gap:8px}
  #questionList .q-item .qnum{
    font-size:11px;opacity:.65;min-width:22px;text-align:center;
    background:rgba(255,255,255,.1);border-radius:3px;padding:1px 4px;flex-shrink:0;
  }
  #questionList .q-item.active .qnum{opacity:.9;background:rgba(0,0,0,.18)}
  #questionList .q-item .qlabel{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  #questionList .q-item .qsub{
    font-size:11px;opacity:.55;margin-top:3px;padding-left:30px;
    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  }
  #questionList .q-item.active .qsub{opacity:.75}

  .content{
    flex:1;display:flex;flex-direction:column;overflow:hidden;
    padding:12px 18px;gap:10px;
  }
  .qhead{display:flex;align-items:center;gap:10px;flex-shrink:0;flex-wrap:wrap}
  .qhead .qtitle{font-size:16px;font-weight:600}
  .qhead .qsubtitle{
    font-size:12px;background:rgba(56,189,248,.18);color:#7dd3fc;
    padding:2px 8px;border-radius:4px;
  }

  .player{
    display:flex;align-items:center;gap:6px;flex-wrap:wrap;
    padding:10px 14px;background:var(--panel);
    border:1px solid var(--line);border-radius:8px;flex-shrink:0;
  }
  .player .divider{width:1px;height:22px;background:var(--line);margin:0 4px}

  .tabs{display:flex;gap:2px;border-bottom:1px solid var(--line);flex-shrink:0}
  .tab-btn{
    background:transparent;border:none;color:var(--muted);
    padding:8px 16px;cursor:pointer;font-size:13px;
    border-bottom:2px solid transparent;margin-bottom:-1px;
    transition:.15s;font-family:inherit;
  }
  .tab-btn:hover{color:var(--text)}
  .tab-btn.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}

  .tab-pane{display:none;flex:1;flex-direction:column;overflow:hidden;gap:10px;min-height:0}
  .tab-pane.active{display:flex}

  #textDisplay{
    flex:1;min-height:120px;resize:none;background:var(--panel2);
    border:1px solid var(--line);color:var(--text);padding:14px 16px;
    border-radius:8px;font-size:15px;line-height:2;font-family:inherit;outline:none;
  }
  #textDisplay:focus{border-color:var(--accent)}

  .voice-card{
    display:flex;align-items:center;gap:8px;flex-wrap:wrap;
    background:var(--panel2);border:1px solid var(--line);border-radius:8px;
    padding:8px 12px;flex-shrink:0;
  }
  .voice-card .vc-label{color:var(--muted);font-size:12px;min-width:44px}
  .voice-card input[type=range]{width:100px}

  select{background:var(--panel2);border:1px solid var(--line);color:var(--text);
         padding:5px 8px;border-radius:6px;font-size:12px;outline:none;max-width:200px}
  input[type=range]{vertical-align:middle;accent-color:var(--accent)}

  .mask-toolbar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;flex-shrink:0}
  .mask-toolbar .spacer{flex:1}
  #maskStatus{
    display:inline-block;padding:3px 10px;border-radius:5px;font-size:12px;
    transition:.2s;color:var(--muted);min-width:80px;text-align:right;
  }
  #maskStatus.ok{color:#4ade80}
  #maskStatus.warn{color:#fbbf24}

  .mask-edit-wrap{
    flex:1;min-height:0;background:#ffffff;
    border:1px solid #cbd5e1;border-radius:10px;overflow:hidden;
    display:flex;flex-direction:column;
  }
  .mask-edit-head{
    display:flex;align-items:center;justify-content:space-between;
    padding:6px 12px;background:#f1f5f9;color:#475569;font-size:12px;
    border-bottom:1px solid #e2e8f0;flex-shrink:0;
  }
  #maskTextArea{
    flex:1;width:100%;min-height:0;resize:none;background:#ffffff;
    color:#1e293b;border:none;padding:14px 18px;
    font-size:16px;line-height:2.1;font-family:inherit;outline:none;display:block;
  }
  #maskTextArea::placeholder{color:#94a3b8}

  #toast{
    position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
    background:#0ea5e9;color:#0b1220;padding:10px 22px;border-radius:8px;
    font-weight:600;font-size:13px;display:none;z-index:9999;
    box-shadow:0 6px 24px rgba(0,0,0,.45);max-width:80vw;text-align:center;line-height:1.6;
  }
  #toast.warn{background:#fbbf24}
  #toast.err{background:#f87171;color:#fff}

  .tip-ok{color:#4ade80}
  .tip-warn{color:#fbbf24}
  .tip-bad{color:#f87171}

  .modal-bg{
    position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.6);
    display:none;z-index:100;align-items:center;justify-content:center;
  }
  .modal-bg.show{display:flex}
  .modal{
    background:var(--panel);border:1px solid var(--line);border-radius:10px;
    padding:20px;min-width:340px;max-width:560px;width:90%;
    box-shadow:0 12px 48px rgba(0,0,0,.6);
  }
  .modal h3{margin:0 0 12px;font-size:15px}
  .modal p{margin:0 0 16px;color:var(--muted);font-size:13px;line-height:1.7}
  .modal input, .modal textarea{
    width:100%;background:var(--panel2);border:1px solid var(--line);
    color:var(--text);padding:8px 12px;border-radius:6px;font-size:13px;
    outline:none;font-family:inherit;
  }
  .modal textarea{resize:none;height:100px;line-height:1.5;word-break:break-all}
  .modal input:focus, .modal textarea:focus{border-color:var(--accent)}
  .modal .modal-actions{
    display:flex;justify-content:flex-end;gap:8px;
  }

  @media (max-width:760px){
    .sidebar{width:150px}
    .content{padding:10px 12px}
    #maskTextArea,#textDisplay{font-size:14px;padding:10px 12px}
    .hw-select{min-width:100px}
  }
</style>
</head>
<body>

<header>
  <h1>🎧 高考日语听力训练器</h1>
  <span class="muted" id="hwLabel">作业</span>
  <select id="hwSelect" class="hw-select"></select>
  <button class="btn tiny" id="newHwBtn" title="新建作业">＋ 新建</button>
  <button class="btn tiny" id="renameHwBtn" title="重命名">✏️ 重命名</button>
  <button class="btn tiny" id="deleteHwBtn" title="删除当前作业">🗑 删除</button>
  <button class="btn tiny" id="shareHwBtn" title="生成分享链接">🔗 分享</button>
  <button class="btn tiny" id="exportHwBtn" title="导出为文件">📤 导出</button>
  <label class="btn tiny" title="从文件导入">📥 导入<input type="file" id="importHwFile" accept=".json,application/json" hidden></label>
  <span class="muted" id="statusText" style="margin-left:auto"></span>
</header>

<div id="readonlyBanner">
  <span id="readonlyMsg">📖 你正在浏览分享的作业，仅可查看和播放</span>
  <button class="btn" id="exitReadonlyBtn">退出浏览</button>
</div>

<main>
  <div id="inputView">
    <div class="hint">
      <b>粘贴听力原文：</b>整段高考日语听力原文粘贴到下方，点「⚡ 分析并切题」。
      <br>· 自动删除中文旁白（开头说明、中间提示等）
      <br>· 按 <b>「听下面的录音，回答第 X 至 Y 题」</b> 识别每组录音
      <br>· 每组内再按 <b>1. 2. 3.</b> 题号切分，每道题都带上提示语和对应对话
    </div>
    <textarea id="sourceInput" placeholder="把整段高考日语听力原文粘贴到这里…"></textarea>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      <button class="btn primary" id="analyzeBtn">⚡ 分析并切题</button>
      <label class="btn">📄 从文件加载<input type="file" id="sourceFile" accept=".txt,.md,.lrc,.srt,.vtt,.ass,.ssa,.html,.htm,.rtf,.docx,.pdf,.json,.csv,text/*,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden></label>
      <button class="btn" id="clearSourceBtn">🗑 清空</button>
    </div>
  </div>

  <div id="questionView">
    <aside class="sidebar">
      <div class="sidebar-head" id="backToInput" title="点击返回编辑原文">
        <span class="sb-title"><span class="sb-back">←</span><span id="sbTitle">题目列表</span></span>
        <span id="qCount" class="muted"></span>
      </div>
      <ul id="questionList"></ul>
    </aside>

    <section class="content">
      <div class="qhead">
        <span class="qtitle" id="qTitle">—</span>
        <span class="qsubtitle" id="qSubtitle" style="display:none"></span>
      </div>

      <div class="player">
        <button class="btn primary" id="playBtn">▶ 播放</button>
        <button class="btn" id="stopBtn">⏹ 停止</button>

        <span class="divider"></span>
        <span class="muted">倍速</span>
        <span id="speedBtns" style="display:inline-flex;gap:4px"></span>

        <span class="divider"></span>
        <span class="muted">跳转</span>
        <button class="btn jump" data-jump="-10">« 10s</button>
        <button class="btn jump" data-jump="-5">« 5s</button>
        <button class="btn jump" data-jump="5">5s »</button>
        <button class="btn jump" data-jump="10">10s »</button>

        <span class="divider"></span>
        <span class="muted" id="ttsTip"></span>
      </div>

      <div class="tabs">
        <button class="tab-btn active" data-tab="text">📝 听力原文</button>
        <button class="tab-btn" data-tab="mask">✏️ 挖空练习</button>
      </div>

      <div class="tab-pane active" data-pane="text">
        <textarea id="textDisplay" placeholder="（本题原文）"></textarea>

        <div class="voice-card">
          <span class="vc-label">女声</span>
          <select id="femaleSel" style="flex:1"><option>（加载中…）</option></select>
          <span class="muted">音高</span>
          <input type="range" id="femalePitch" min="0.7" max="1.3" step="0.05" value="1">
          <span class="muted" id="femalePitchVal">1.00</span>
          <button class="btn tiny" id="testFemale">试听</button>
        </div>

        <div class="voice-card">
          <span class="vc-label">男声</span>
          <select id="maleSel" style="flex:1"><option>（加载中…）</option></select>
          <span class="muted">音高</span>
          <input type="range" id="malePitch" min="0.6" max="1.1" step="0.05" value="1">
          <span class="muted" id="malePitchVal">1.00</span>
          <button class="btn tiny" id="testMale">试听</button>
        </div>
      </div>

      <div class="tab-pane" data-pane="mask">
        <div class="mask-toolbar">
          <button class="btn" id="maskCopyBtn">📋 从原文复制</button>
          <button class="btn" id="maskClearBtn">🗑 清空</button>
          <button class="btn" id="maskUnderlineBtn">➖ 选中变填空</button>
          <span class="spacer"></span>
          <span id="maskStatus">就绪</span>
        </div>

        <div class="mask-edit-wrap">
          <div class="mask-edit-head">
            <span>✏️ 挖空文本（可直接编辑）</span>
            <span class="muted">自动保存</span>
          </div>
          <textarea id="maskTextArea" placeholder="点「从原文复制」把本题原文复制过来，再选中要挖空的文字，点「选中变填空」。"></textarea>
        </div>
      </div>
    </section>
  </div>
</main>

<div class="modal-bg" id="renameModal">
  <div class="modal">
    <h3>重命名作业</h3>
    <input type="text" id="renameInput" placeholder="输入作业名称">
    <div class="modal-actions" style="margin-top:16px">
      <button class="btn" id="renameCancel">取消</button>
      <button class="btn primary" id="renameConfirm">确定</button>
    </div>
  </div>
</div>

<div class="modal-bg" id="deleteModal">
  <div class="modal">
    <h3>删除作业</h3>
    <p id="deleteMsg">确定要删除这个作业吗？此操作不可恢复。</p>
    <div class="modal-actions">
      <button class="btn" id="deleteCancel">取消</button>
      <button class="btn danger" id="deleteConfirm">确定删除</button>
    </div>
  </div>
</div>

<div class="modal-bg" id="shareModal">
  <div class="modal">
    <h3>分享作业链接</h3>
    <p id="shareTip">把下面的链接发给别人，别人打开就能看到这份作业（只读，不能编辑）。<br>
    如果链接过长，某些聊天工具可能截断，建议用邮件或复制粘贴到记事本发送。</p>
    <textarea id="shareUrl" readonly></textarea>
    <div class="modal-actions" style="margin-top:16px">
      <button class="btn" id="shareClose">关闭</button>
      <button class="btn primary" id="shareCopy">复制链接</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
/* ==================== 基础工具 ==================== */
var $ = function (s) { return document.querySelector(s); };
var $$ = function (s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };

var STORAGE_KEY = 'jp-listening-trainer-v25';

var SPEED_OPTIONS = [
  { label: '原速', value: 1.0 },
  { label: '1.2×', value: 1.2 },
  { label: '1.5×', value: 1.5 }
];

var state = {
  view: 'input',
  currentHwId: '',
  homeworks: [],
  ttsRate: 1,
  femaleVoice: '',
  maleVoice: '',
  femalePitch: 1,
  malePitch: 1,
  readonly: false,
  sharedHw: null
};

function currentHw() {
  if (state.readonly && state.sharedHw) return state.sharedHw;
  for (var i = 0; i < state.homeworks.length; i++) {
    if (state.homeworks[i].id === state.currentHwId) return state.homeworks[i];
  }
  return null;
}

function createHomework(name, sourceText) {
  return {
    id: 'hw_' + Date.now() + '_' + Math.random().toString(36).slice(2, 7),
    name: name || ('作业 ' + (state.homeworks.length + 1)),
    createdAt: Date.now(),
    updatedAt: Date.now(),
    sourceText: sourceText || '',
    questions: [],
    currentIndex: 0
  };
}

/* ==================== 提示 ==================== */
var toastTimer = null;
function showToast(msg, type, persistent) {
  var el = $('#toast');
  el.innerHTML = msg;
  el.className = type === 'warn' ? 'warn' : (type === 'err' ? 'err' : '');
  el.style.display = 'block';
  clearTimeout(toastTimer);
  if (!persistent) toastTimer = setTimeout(function () { el.style.display = 'none'; }, 2400);
}
function hideToast() { clearTimeout(toastTimer); $('#toast').style.display = 'none'; }

/* ==================== 存储 ==================== */
function save() {
  if (state.readonly) return;
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch (e) {}
}
var saveTimer = null;
function saveSoon() { clearTimeout(saveTimer); saveTimer = setTimeout(save, 400); }

function loadState() {
  try {
    var raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return;
    var d = JSON.parse(raw);
    if (d && typeof d === 'object') {
      Object.keys(state).forEach(function (k) {
        if (k in d && k !== 'readonly' && k !== 'sharedHw') state[k] = d[k];
      });
    }
  } catch (e) {}
  if (!Array.isArray(state.homeworks)) state.homeworks = [];
}

/* ==================== 工具 ==================== */
function normalizeNum(s) {
  if (!s) return s;
  var result = '';
  for (var i = 0; i < s.length; i++) {
    var c = s.charCodeAt(i);
    if (c >= 0xFF10 && c <= 0xFF19) result += String.fromCharCode(c - 0xFF10 + 48);
    else result += s[i];
  }
  return result;
}

function isJapaneseLine(line) {
  return /[\u3040-\u309f\u30a0-\u30ff\u30fc]/.test(line);
}

function isPromptLine(line) {
  return /听下[面边][\s\S]{0,50}?(?:录音|对话|短文|会话|材料|内容)[\s\S]{0,40}?回答第\s*[0-9０-９]+/i.test(line);
}

var SPEAKER_LINE_RE = /^(?:女の人|男の人|女性|男性|女の子|男の子|女|男|[FMfm]\d?)\s*[:：]/;

function cleanSourceText(text) {
  var lines = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
  var out = [];
  var removed = 0;
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    var trimmed = line.trim();
    if (!trimmed) { out.push(line); continue; }
    if (isPromptLine(trimmed)) { out.push(line); continue; }
    if (isJapaneseLine(trimmed)) { out.push(line); continue; }
    if (SPEAKER_LINE_RE.test(trimmed)) { out.push(line); continue; }
    removed++;
  }
  return { text: out.join('\n'), removed: removed };
}

/* ==================== 切题 ==================== */
function buildPromptRegex() {
  return /听下[面边][\s\S]{0,50}?(?:录音|对话|短文|会话|材料|内容)[\s\S]{0,40}?回答第\s*([0-9０-９]+)\s*(?:[至到\-—~～]\s*([0-9０-９]+))?\s*[小题]*题/g;
}

function splitQuestions(text) {
  var normalized = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
  var re = buildPromptRegex();
  var promptMatches = [];
  var m;
  while ((m = re.exec(normalized)) !== null) {
    if (m.index === re.lastIndex) re.lastIndex++;
    promptMatches.push({
      index: m.index,
      length: m[0].length,
      full: m[0],
      from: normalizeNum(m[1]),
      to: normalizeNum(m[2] || m[1])
    });
  }
  if (!promptMatches.length) return fallbackSplit(normalized);

  var result = [];
  for (var i = 0; i < promptMatches.length; i++) {
    var pm = promptMatches[i];
    var from = pm.from;
    var to = pm.to;
    var rangeLabel = (from === to) ? ('第 ' + from + ' 题') : ('第 ' + from + '–' + to + ' 题');
    var promptText = pm.full.replace(/[ \t]+/g, ' ').replace(/\n+/g, ' ').trim();

    var afterStart = pm.index + pm.length;
    var afterEnd = (i + 1 < promptMatches.length) ? promptMatches[i + 1].index : normalized.length;
    var afterText = normalized.slice(afterStart, afterEnd).trim();

    var numbered = afterText ? splitByNumber(afterText, from, to) : [];

    if (numbered.length > 0) {
      numbered.forEach(function (q) {
        q.text = promptText + '\n\n' + q.text;
        q.subtitle = rangeLabel;
        result.push(q);
      });
    } else {
      result.push({
        type: 'prompt',
        title: rangeLabel,
        subtitle: '听力录音',
        text: promptText + (afterText ? '\n\n' + afterText : ''),
        maskText: '',
        from: from,
        to: to
      });
    }
  }
  return result;
}

function splitByNumber(text, startNum, endNum) {
  var startInt = parseInt(startNum, 10);
  var endInt = parseInt(endNum, 10);
  if (isNaN(startInt) || isNaN(endInt)) return [];

  var lines = text.split('\n');
  var result = [];
  var currentNum = null;
  var currentText = '';
  var numRe = /^\s*([0-9０-９]{1,2})\s*[.、．)）:：]\s*(.*)$/;

  function pushCurrent() {
    if (currentNum !== null && currentText.trim()) {
      result.push({
        type: 'prompt',
        title: '第 ' + currentNum + ' 题',
        subtitle: '题号 ' + currentNum,
        text: currentText.trim(),
        maskText: '',
        from: currentNum,
        to: currentNum
      });
    }
  }

  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    var trimmed = line.trim();
    if (!trimmed) { if (currentText) currentText += '\n'; continue; }
    var m = trimmed.match(numRe);
    if (m) {
      var nStr = normalizeNum(m[1]);
      var n = parseInt(nStr, 10);
      var expected = (currentNum === null) ? startInt : (currentNum + 1);
      if (!isNaN(n) && n >= startInt && n <= endInt && n === expected) {
        pushCurrent();
        currentNum = n;
        currentText = m[2] ? m[2] + '\n' : '';
        continue;
      }
    }
    currentText += line + '\n';
  }
  pushCurrent();
  return result;
}

function fallbackSplit(text) {
  var blocks = text.split(/\n\s*\n/).filter(function (b) { return b.trim(); });
  if (blocks.length <= 1) {
    return [{ type: 'prompt', title: '全文', subtitle: '', text: text.trim(), maskText: '' }];
  }
  var result = [];
  for (var i = 0; i < blocks.length; i++) {
    result.push({ type: 'prompt', title: '第 ' + (i + 1) + ' 段', subtitle: '', text: blocks[i].trim(), maskText: '' });
  }
  return result;
}

/* ==================== 分享编码 ==================== */
function encodeShareData(obj) {
  try {
    var json = JSON.stringify(obj);
    var bytes;
    if (typeof TextEncoder !== 'undefined') {
      bytes = new TextEncoder().encode(json);
    } else {
      var arr = [];
      for (var i = 0; i < json.length; i++) {
        var c = json.charCodeAt(i);
        if (c < 128) arr.push(c);
        else if (c < 2048) arr.push(192 | (c >> 6), 128 | (c & 63));
        else arr.push(224 | (c >> 12), 128 | ((c >> 6) & 63), 128 | (c & 63));
      }
      bytes = new Uint8Array(arr);
    }
    var compressed;
    if (window.pako) {
      compressed = pako.deflate(bytes);
    } else {
      compressed = bytes;
    }
    var binary = '';
    var chunkSize = 0x8000;
    for (var j = 0; j < compressed.length; j += chunkSize) {
      binary += String.fromCharCode.apply(null, compressed.subarray(j, j + chunkSize));
    }
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  } catch (e) {
    console.error('encode fail', e);
    return '';
  }
}

function decodeShareData(str) {
  try {
    var b64 = str.replace(/-/g, '+').replace(/_/g, '/');
    while (b64.length % 4) b64 += '=';
    var binary = atob(b64);
    var bytes = new Uint8Array(binary.length);
    for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
    var decompressed;
    if (window.pako) {
      decompressed = pako.inflate(bytes);
    } else {
      decompressed = bytes;
    }
    var json;
    if (typeof TextDecoder !== 'undefined') {
      json = new TextDecoder().decode(decompressed);
    } else {
      var s = '';
      for (var j = 0; j < decompressed.length; j++) s += String.fromCharCode(decompressed[j]);
      json = decodeURIComponent(escape(s));
    }
    return JSON.parse(json);
  } catch (e) {
    console.error('decode fail', e);
    return null;
  }
}

