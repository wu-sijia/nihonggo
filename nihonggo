function findVoiceByName(name) {
  var vs = window.speechSynthesis.getVoices();
  for (var i = 0; i < vs.length; i++) if (vs[i].name === name) return vs[i];
  return null;
}

function findChineseVoice() {
  var vs = window.speechSynthesis.getVoices();
  if (!vs.length) return null;
  var zh = vs.filter(function (v) { return /^zh/i.test(v.lang) && isRealHumanVoice(v.name); });
  if (!zh.length) return null;
  return pickVoiceByName(zh, CN_PREFER) || zh[0];
}

function resolveJapaneseVoice(gender) {
  var name = (gender === 'male') ? $('#maleSel').value : $('#femaleSel').value;
  var v = findVoiceByName(name);
  if (v) return v;
  var vs = window.speechSynthesis.getVoices();
  for (var i = 0; i < vs.length; i++) {
    if (/^ja/i.test(vs[i].lang) && isRealHumanVoice(vs[i].name)) return vs[i];
  }
  return null;
}

function chunkText(text, max) {
  max = max || 70;
  var out = [];
  var cur = '';
  var strongEnd = '。！？!?；;\n';
  var softEnd = '、，,';
  for (var i = 0; i < text.length; i++) {
    var c = text.charAt(i);
    cur += c;
    if (strongEnd.indexOf(c) >= 0) {
      if (cur.trim()) out.push({ text: cur, pause: 100 });
      cur = '';
    } else if (softEnd.indexOf(c) >= 0 && cur.length >= 8) {
      if (cur.trim()) out.push({ text: cur, pause: 50 });
      cur = '';
    } else if (cur.length >= max) {
      if (cur.trim()) out.push({ text: cur, pause: 80 });
      cur = '';
    }
  }
  if (cur.trim()) out.push({ text: cur, pause: 100 });
  return out.length ? out : [{ text: text, pause: 100 }];
}

function buildQueue(text) {
  var rawLines = text.split('\n');
  var spkRe = /^(女の人|男の人|女性|男性|女の子|男の子|女|男|[FMfm]\d?)\s*[:：]\s*/;

  var parsed = [];
  rawLines.forEach(function (line) {
    var trimmed = line.trim();
    if (!trimmed) return;

    var gender = null;
    var m = trimmed.match(spkRe);
    var hasSpeaker = false;
    var content = trimmed;

    if (m) {
      hasSpeaker = true;
      var tag = m[1];
      if (/女/.test(tag) || /^[Ff]/.test(tag)) gender = 'female';
      else if (/男/.test(tag) || /^[Mm]/.test(tag)) gender = 'male';
      content = trimmed.replace(spkRe, '');
    }

    content = content.replace(/^\s*[0-9０-９]{1,2}\s*[.、．)）:：]\s*/, '');
    if (!content) return;

    parsed.push({ hasSpeaker: hasSpeaker, gender: gender, text: content });
  });

  var merged = [];
  var lastGender = null;
  var sentenceEndRe = /[。！？!?]$/;

  parsed.forEach(function (p) {
    var gender;
    if (p.hasSpeaker) { gender = p.gender; lastGender = p.gender; }
    else { gender = lastGender; }

    if (merged.length === 0) {
      merged.push({ gender: gender, text: p.text });
      return;
    }
    var prev = merged[merged.length - 1];
    var prevTrimmed = prev.text.replace(/[ \t]+$/g, '');
    var prevEndsSentence = sentenceEndRe.test(prevTrimmed);

    if (prev.gender === gender && !prevEndsSentence) {
      prev.text = prevTrimmed + p.text;
    } else {
      merged.push({ gender: gender, text: p.text });
    }
  });

  var queue = [];
  merged.forEach(function (block, blockIdx) {
    var lang = isJapaneseLine(block.text) ? 'ja' : 'zh';
    var chunks = chunkText(block.text, 70);
    var isLastBlock = (blockIdx === merged.length - 1);
    chunks.forEach(function (c, chunkIdx) {
      var pause = c.pause || 100;
      if (chunkIdx === chunks.length - 1 && !isLastBlock) pause += 130;
      queue.push({ text: c.text, pause: pause, gender: block.gender, lang: lang });
    });
  });

  return queue;
}

function ttsStart(queue) {
  if (!ttsSupported()) { showToast('当前浏览器不支持语音合成', 'err'); return; }
  if (!queue || !queue.length) { showToast('没有可朗读的内容', 'warn'); return; }
  ttsToken++;
  window.speechSynthesis.cancel();
  ttsQueue = queue;
  ttsIndex = 0;
  ttsPausedChunk = 0;
  ttsState = 'playing';
  updatePlayBtn();
  var my = ttsToken;
  setTimeout(function () { nextChunk(my); }, 60);
}
function nextChunk(my) {
  if (my !== ttsToken || ttsState !== 'playing') return;
  if (ttsIndex >= ttsQueue.length) { ttsState = 'idle'; updatePlayBtn(); return; }
  var item = ttsQueue[ttsIndex];
  var u = new SpeechSynthesisUtterance(item.text);

  if (item.lang === 'zh') {
    var vzh = findChineseVoice();
    if (vzh) { u.voice = vzh; u.lang = vzh.lang; }
    else { u.lang = 'zh-CN'; }
    u.pitch = 1;
  } else {
    var vja = resolveJapaneseVoice(item.gender);
    if (vja) { u.voice = vja; u.lang = vja.lang; }
    else { u.lang = 'ja-JP'; }
    u.pitch = (item.gender === 'male')
      ? (parseFloat($('#malePitch').value) || 1)
      : (parseFloat($('#femalePitch').value) || 1);
  }
  u.rate = parseFloat(state.ttsRate) || 1;
  u.volume = 1;

  u.onend = function () {
    if (my !== ttsToken) return;
    ttsIndex++;
    if (ttsState !== 'playing') return;
    setTimeout(function () { nextChunk(my); }, item.pause || 100);
  };
  u.onerror = function (e) {
    if (my !== ttsToken) return;
    console.warn('TTS error:', e && e.error, item.text);
    if (ttsIndex === 0) {
      showToast('语音合成失败：请使用 Edge 浏览器', 'err');
      ttsState = 'idle';
      updatePlayBtn();
    } else {
      ttsIndex++;
      setTimeout(function () { nextChunk(my); }, 100);
    }
  };
  ttsPausedChunk = ttsIndex;
  window.speechSynthesis.speak(u);
}
function ttsPause() {
  if (ttsState !== 'playing') return;
  ttsState = 'paused'; ttsToken++;
  window.speechSynthesis.cancel();
  updatePlayBtn();
}
function ttsResume() {
  if (ttsState !== 'paused') return;
  ttsState = 'playing';
  ttsIndex = ttsPausedChunk;
  ttsToken++;
  updatePlayBtn();
  var my = ttsToken;
  setTimeout(function () { nextChunk(my); }, 60);
}
function stopTTS() {
  ttsToken++;
  ttsState = 'idle';
  ttsQueue = []; ttsIndex = 0;
  if (ttsSupported()) window.speechSynthesis.cancel();
  updatePlayBtn();
}
function updatePlayBtn() {
  var btn = $('#playBtn');
  if (!btn) return;
  if (ttsState === 'playing') btn.textContent = '⏸ 暂停';
  else if (ttsState === 'paused') btn.textContent = '▶ 继续';
  else btn.textContent = '▶ 播放';
}
function playCurrent() {
  var hw = currentHw();
  if (!hw) return;
  var q = hw.questions[hw.currentIndex];
  if (!q) return;
  if (ttsState === 'playing') { ttsPause(); return; }
  if (ttsState === 'paused') { ttsResume(); return; }
  var queue = buildQueue(q.text || '');
  if (!queue.length) { showToast('本题没有可朗读的内容', 'warn'); return; }
  ttsStart(queue);
}

function estimateChunkMs(item) {
  if (!item) return 0;
  var rate = parseFloat(state.ttsRate) || 1;
  var charCount = (item.text || '').length;
  var perCharSec = (item.lang === 'ja') ? 0.15 : 0.20;
  var speechSec = charCount * perCharSec / rate;
  var pauseSec = (item.pause || 100) / 1000;
  return (speechSec + pauseSec) * 1000;
}

function jumpBySeconds(seconds) {
  var hw = currentHw();
  if (!hw) return;

  if (!ttsQueue.length) {
    var q = hw.questions[hw.currentIndex];
    if (!q) return;
    ttsQueue = buildQueue(q.text || '');
    ttsIndex = 0;
    ttsPausedChunk = 0;
    ttsState = 'paused';
  }

  var targetMs = Math.abs(seconds) * 1000;
  var acc = 0;
  var newIndex = ttsIndex;

  if (seconds > 0) {
    while (newIndex < ttsQueue.length && acc < targetMs) {
      acc += estimateChunkMs(ttsQueue[newIndex]);
      newIndex++;
    }
    if (newIndex >= ttsQueue.length) newIndex = ttsQueue.length - 1;
  } else {
    while (newIndex > 0 && acc < targetMs) {
      newIndex--;
      acc += estimateChunkMs(ttsQueue[newIndex]);
    }
  }

  var wasPlaying = (ttsState === 'playing');
  ttsToken++;
  window.speechSynthesis.cancel();

  ttsIndex = newIndex;
  ttsPausedChunk = newIndex;

  if (wasPlaying) {
    ttsState = 'playing';
    var my = ttsToken;
    setTimeout(function () { nextChunk(my); }, 50);
  } else {
    ttsState = 'paused';
  }
  updatePlayBtn();

  var direction = seconds > 0 ? '快进' : '回退';
  showToast(direction + ' ' + Math.abs(seconds) + 's → 第 ' + (newIndex + 1) + '/' + ttsQueue.length + ' 句');
}

function ttsPreview(gender) {
  if (!ttsSupported()) { showToast('当前浏览器不支持语音合成', 'err'); return; }
  stopTTS();
  var text = (gender === 'male')
    ? 'はい、田中です。明日の会議は、午後二時からですよ。'
    : 'もしもし、田中さんですか。明日の会議は、何時からですか。';
  var u = new SpeechSynthesisUtterance(text);
  var v = resolveJapaneseVoice(gender);
  if (v) { u.voice = v; u.lang = v.lang; }
  else u.lang = 'ja-JP';
  u.pitch = (gender === 'male')
    ? (parseFloat($('#malePitch').value) || 1)
    : (parseFloat($('#femalePitch').value) || 1);
  u.rate = parseFloat(state.ttsRate) || 1;
  u.volume = 1;
  window.speechSynthesis.speak(u);
}

/* ==================== 多格式文件读取 ==================== */
var mammothPromise = null;
var pdfPromise = null;

function ensureMammoth() {
  if (window.mammoth) return Promise.resolve(window.mammoth);
  if (mammothPromise) return mammothPromise;
  mammothPromise = new Promise(function (resolve, reject) {
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.6.0/mammoth.browser.min.js';
    s.onload = function () { resolve(window.mammoth); };
    s.onerror = function () { mammothPromise = null; reject(new Error('mammoth 库加载失败，请检查网络')); };
    document.head.appendChild(s);
  });
  return mammothPromise;
}
function ensurePdfJs() {
  if (window.pdfjsLib) return Promise.resolve(window.pdfjsLib);
  if (pdfPromise) return pdfPromise;
  pdfPromise = new Promise(function (resolve, reject) {
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
    s.onload = function () { resolve(window.pdfjsLib); };
    s.onerror = function () { pdfPromise = null; reject(new Error('pdf.js 库加载失败，请检查网络')); };
    document.head.appendChild(s);
  });
  return pdfPromise;
}
function stripLrc(text) {
  return text.replace(/\[\d{1,2}:\d{2}(\.\d{1,3})?\]/g, '')
             .replace(/^\[[a-zA-Z]+:.+\]$/gm, '')
             .replace(/\n{3,}/g, '\n\n').trim();
}
function stripSubtitle(text) {
  return text.split('\n').map(function (line) {
    if (/^\s*WEBVTT/i.test(line)) return '';
    if (/^\s*NOTE\b/i.test(line)) return '';
    if (/\d{1,2}:\d{2}:\d{2}[,.]\d{1,3}\s*-->/.test(line)) return '';
    if (/^\s*\d+\s*$/.test(line)) return '';
    return line;
  }).join('\n').replace(/\n{3,}/g, '\n\n').trim();
}
function stripAss(text) {
  return text.split('\n').map(function (line) {
    if (/^\s*\[/.test(line)) return '';
    if (/^\s*(Format|Style|Comment|Title|ScriptType|PlayResX|PlayResY|WrapStyle|ScaledBorderAndShadow|Collisions|Timer|YCbCr Matrix|Audio File|Video File)\s*:/.test(line)) return '';
    if (/^Dialogue\s*:/i.test(line)) {
      var parts = line.split(',');
      return parts.slice(9).join(',').replace(/\{[^}]*\}/g, '').replace(/\\N/gi, '\n').trim();
    }
    return '';
  }).filter(function (l) { return l.trim(); }).join('\n').trim();
}
function extractHtmlText(html) {
  var doc = new DOMParser().parseFromString(html, 'text/html');
  doc.querySelectorAll('script,style,noscript,head').forEach(function (n) { n.remove(); });
  var body = doc.body;
  if (!body) return '';
  var txt = body.innerText || body.textContent || '';
  return txt.replace(/\r\n/g, '\n').replace(/\r/g, '\n')
            .replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
}
function extractPdfText(arrayBuffer) {
  return ensurePdfJs().then(function (pdfjsLib) {
    pdfjsLib.GlobalWorkerOptions.workerSrc =
      'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    return pdfjsLib.getDocument({ data: new Uint8Array(arrayBuffer) }).promise;
  }).then(function (pdf) {
    var allPages = [];
    var chain = Promise.resolve();
    for (var i = 1; i <= pdf.numPages; i++) {
      (function (pageNum) {
        chain = chain.then(function () {
          return pdf.getPage(pageNum).then(function (page) {
            return page.getTextContent().then(function (tc) {
              var lines = [], cur = '';
              tc.items.forEach(function (it) {
                cur += it.str || '';
                if (it.hasEOL) { if (cur.trim()) lines.push(cur); cur = ''; }
              });
              if (cur.trim()) lines.push(cur);
              allPages.push(lines.join('\n'));
            });
          });
        });
      })(i);
    }
    return chain.then(function () {
      return allPages.join('\n\n')
        .replace(/\r\n/g, '\n').replace(/\r/g, '\n')
        .replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n').trim();
    });
  });
}
function extractDocxText(arrayBuffer) {
  return ensureMammoth().then(function (mammoth) {
    return mammoth.extractRawText({ arrayBuffer: arrayBuffer });
  }).then(function (result) {
    return String(result.value || '')
      .replace(/\r\n/g, '\n').replace(/\r/g, '\n')
      .replace(/\n{3,}/g, '\n\n').trim();
  });
}
function readSourceFile(file) {
  return new Promise(function (resolve, reject) {
    var ext = ((file.name || '').split('.').pop() || '').toLowerCase();
    if (['txt','md','markdown','lrc','srt','vtt','ass','ssa','json','csv','rtf'].indexOf(ext) >= 0) {
      var r = new FileReader();
      r.onload = function () {
        var txt = String(r.result || '').replace(/\r\n/g, '\n').replace(/\r/g, '\n');
        if (ext === 'lrc') txt = stripLrc(txt);
        else if (ext === 'srt' || ext === 'vtt') txt = stripSubtitle(txt);
        else if (ext === 'ass' || ext === 'ssa') txt = stripAss(txt);
        resolve(txt.trim());
      };
      r.onerror = function () { reject(new Error('文件读取失败')); };
      r.readAsText(file, 'utf-8');
      return;
    }
    if (ext === 'html' || ext === 'htm') {
      var rh = new FileReader();
      rh.onload = function () {
        try { resolve(extractHtmlText(String(rh.result || ''))); }
        catch (e) { reject(new Error('HTML 解析失败：' + e.message)); }
      };
      rh.onerror = function () { reject(new Error('文件读取失败')); };
      rh.readAsText(file, 'utf-8');
      return;
    }
    if (ext === 'docx') {
      var rd = new FileReader();
      rd.onload = function () {
        extractDocxText(rd.result).then(resolve).catch(function (err) { reject(new Error('docx 解析失败：' + err.message)); });
      };
      rd.onerror = function () { reject(new Error('文件读取失败')); };
      rd.readAsArrayBuffer(file);
      return;
    }
    if (ext === 'doc') { reject(new Error('不支持旧版 .doc。请用 Word 另存为 .docx 或 .txt')); return; }
    if (ext === 'pdf') {
      var rp = new FileReader();
      rp.onload = function () {
        extractPdfText(rp.result).then(resolve).catch(function (err) { reject(new Error('pdf 解析失败：' + err.message)); });
      };
      rp.onerror = function () { reject(new Error('文件读取失败')); };
      rp.readAsArrayBuffer(file);
      return;
    }
    reject(new Error('不支持的格式：.' + ext));
  });
}
function loadSourceFromFile(file) {
  if (!file) return;
  if (state.readonly) return;
  var hw = currentHw();
