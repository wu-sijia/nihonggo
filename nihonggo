      hw.questions = Array.isArray(d.questions) ? d.questions.map(function (q, i) {
        return {
          type: q.type || 'prompt',
          title: q.title || ('第 ' + (i + 1) + ' 题'),
          subtitle: q.subtitle || '',
          text: q.text || '',
          maskText: q.maskText || '',
          from: q.from,
          to: q.to
        };
      }) : [];
      hw.currentIndex = d.currentIndex || 0;
      state.homeworks.unshift(hw);
      state.currentHwId = hw.id;
      state.view = hw.questions.length ? 'questions' : 'input';
      if (d.ttsRate) state.ttsRate = d.ttsRate;
      if (d.femaleVoice) state.femaleVoice = d.femaleVoice;
      if (d.maleVoice) state.maleVoice = d.maleVoice;
      if (d.femalePitch) state.femalePitch = d.femalePitch;
      if (d.malePitch) state.malePitch = d.malePitch;
      stopTTS();
      fillVoiceSelects();
      renderHwSelect();
      renderAll();
      save();
      showToast('已导入：' + hw.name);
    } catch (err) {
      showToast('导入失败：' + err.message, 'err');
