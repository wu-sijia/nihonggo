function analyzeAndSplit() {
  if (state.readonly) return;
  var hw = currentHw();
  if (!hw) { showToast('请先新建作业', 'warn'); return; }
  var rawText = ($('#sourceInput').value || '').trim();
  if (!rawText) { showToast('请先粘贴听力原文', 'warn'); return; }

  if (hw.questions && hw.questions.length) {
    if (!confirm('将重新分析并切分。\n\n已切分内容的原文编辑和挖空会丢失（完整原文会保留在输入框中）。继续？')) return;
  }

  var cleaned = cleanSourceText(rawText);
  if (!cleaned.text.trim()) { showToast('清洗后没有剩余内容，请检查原文', 'err'); return; }

  var questions = splitQuestions(cleaned.text);
  if (!questions.length) { showToast('未识别到题目内容，请检查原文格式', 'warn'); return; }

  hw.sourceText = rawText;
  hw.questions = questions;
  hw.currentIndex = 0;
  hw.updatedAt = Date.now();
  state.view = 'questions';
  stopTTS();
  renderHwSelect();
  renderAll();
  save();

  var msg = [];
  if (cleaned.removed > 0) msg.push('已删除 ' + cleaned.removed + ' 行中文旁白');
  msg.push('切分为 ' + questions.length + ' 题');
  showToast('✔ ' + msg.join('，'));
}

