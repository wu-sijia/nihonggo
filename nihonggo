    var hw = currentHw();
    if (!hw) return;
    if (($('#sourceInput').value || '').trim()) {
      $('#sourceInput').value = '';
      hw.sourceText = '';
      save();
      showToast('已清空');
    }
  });

  $('#sourceFile').addEventListener('change', function (e) {
    if (state.readonly) return;
    var f = e.target.files[0];
    if (!f) return;
    loadSourceFromFile(f);
    e.target.value = '';
  });

  var src = $('#sourceInput');
  ['dragenter','dragover'].forEach(function (ev) {
    src.addEventListener(ev, function (e) {
      e.preventDefault(); e.stopPropagation();
      if (!state.readonly) src.classList.add('dragover');
    });
  });
  ['dragleave','dragend'].forEach(function (ev) {
    src.addEventListener(ev, function (e) {
      e.preventDefault(); e.stopPropagation();
      src.classList.remove('dragover');
    });
  });
  src.addEventListener('drop', function (e) {
    e.preventDefault(); e.stopPropagation();
    src.classList.remove('dragover');
    if (state.readonly) return;
    var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
    if (f) loadSourceFromFile(f);
  });
  document.addEventListener('dragover', function (e) { e.preventDefault(); });
  document.addEventListener('drop', function (e) { e.preventDefault(); });

  src.addEventListener('input', function () {
    if (state.readonly) return;
    var hw = currentHw();
    if (!hw) return;
    hw.sourceText = this.value;
    hw.updatedAt = Date.now();
    saveSoon();
  });

  $$('.tab-btn').forEach(function (b) {
    b.addEventListener('click', function () {
      var tab = b.getAttribute('data-tab');
      $$('.tab-btn').forEach(function (x) { x.classList.toggle('active', x === b); });
      $$('.tab-pane').forEach(function (p) {
        p.classList.toggle('active', p.getAttribute('data-pane') === tab);
      });
    });
  });

  $('#playBtn').addEventListener('click', playCurrent);
  $('#stopBtn').addEventListener('click', stopTTS);

  $$('[data-jump]').forEach(function (b) {
    b.addEventListener('click', function () {
      jumpBySeconds(parseFloat(b.getAttribute('data-jump')));
    });
  });

  $('#femalePitch').addEventListener('input', function (e) {
    $('#femalePitchVal').textContent = Number(e.target.value).toFixed(2);
  });
  $('#femalePitch').addEventListener('change', function () {
    if (state.readonly) return;
    state.femalePitch = parseFloat(this.value); save();
  });
  $('#malePitch').addEventListener('input', function (e) {
    $('#malePitchVal').textContent = Number(e.target.value).toFixed(2);
  });
  $('#malePitch').addEventListener('change', function () {
    if (state.readonly) return;
    state.malePitch = parseFloat(this.value); save();
  });

  $('#testFemale').addEventListener('click', function () { ttsPreview('female'); });
  $('#testMale').addEventListener('click', function () { ttsPreview('male'); });

  $('#femaleSel').addEventListener('change', function () {
    if (state.readonly) return;
    state.femaleVoice = this.value; save();
  });
  $('#maleSel').addEventListener('change', function () {
    if (state.readonly) return;
    state.maleVoice = this.value;
    save();
  });

  $('#textDisplay').addEventListener('input', function () {
    if (state.readonly) return;
    var hw = currentHw();
    if (!hw) return;
    var q = hw.questions[hw.currentIndex];
    if (!q) return;
    q.text = this.value;
    hw.updatedAt = Date.now();
    saveSoon();
  });

  $('#maskCopyBtn').addEventListener('click', function () {
    if (state.readonly) return;
    var hw = currentHw();
    if (!hw) return;
    var q = hw.questions[hw.currentIndex];
    if (!q) return;
    var s = (q.text || '').trim();
    if (!s) { showToast('本题原文为空', 'warn'); return; }
    $('#maskTextArea').value = q.text;
    q.maskText = q.text;
    hw.updatedAt = Date.now();
    save();
    showToast('已复制原文');
  });

  $('#maskClearBtn').addEventListener('click', function () {
    if (state.readonly) return;
    var hw = currentHw();
    if (!hw) return;
    var q = hw.questions[hw.currentIndex];
    if (!q) return;
    var ta = $('#maskTextArea');
    if (!(ta.value || '').trim()) { showToast('已经是空的', 'warn'); return; }
    ta.value = '';
    q.maskText = '';
    hw.updatedAt = Date.now();
    save();
    showToast('已清空');
  });

  $('#maskUnderlineBtn').addEventListener('click', function () {
    if (state.readonly) return;
    var hw = currentHw();
    if (!hw) return;
    var q = hw.questions[hw.currentIndex];
    if (!q) return;
    var ta = $('#maskTextArea');
    var start = ta.selectionStart, end = ta.selectionEnd;
    if (start === end) { showToast('请先用鼠标选中要挖空的文字', 'warn'); ta.focus(); return; }
    var text = ta.value;
    var sel = text.slice(start, end);
    var blank = '＿'.repeat(Math.max(2, Math.min(8, sel.length)));
    ta.value = text.slice(0, start) + blank + text.slice(end);
    ta.selectionStart = ta.selectionEnd = start + blank.length;
    q.maskText = ta.value;
    hw.updatedAt = Date.now();
    save();
    showToast('已挖空 ' + sel.length + ' 字');
    ta.focus();
  });

  $('#maskTextArea').addEventListener('input', function () {
    if (state.readonly) return;
    var hw = currentHw();
    if (!hw) return;
    var q = hw.questions[hw.currentIndex];
    if (!q) return;
    q.maskText = this.value;
    hw.updatedAt = Date.now();
    saveSoon();
  });

  document.addEventListener('keydown', function (e) {
    var tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select') return;
    if (state.view !== 'questions') return;
    if (e.code === 'Space') { e.preventDefault(); playCurrent(); }
    else if (e.code === 'ArrowUp' || e.code === 'ArrowLeft') {
      e.preventDefault();
      var hw = currentHw();
      if (hw) selectQuestion(hw.currentIndex - 1);
    }
    else if (e.code === 'ArrowDown' || e.code === 'ArrowRight') {
      e.preventDefault();
      var hw2 = currentHw();
      if (hw2) selectQuestion(hw2.currentIndex + 1);
    }
  });

  window.addEventListener('beforeunload', function () {
    if (ttsSupported()) window.speechSynthesis.cancel();
  });
}

/* ==================== 启动 ==================== */
function init() {
  /* ★ 优先检查分享链接 */
  var loadedShared = loadSharedHomeworkFromHash();

  if (!loadedShared) {
    loadState();

    if (!state.homeworks.length) {
      var hw = createHomework('作业 1', '');
      state.homeworks.push(hw);
      state.currentHwId = hw.id;
    } else if (!currentHw()) {
      state.currentHwId = state.homeworks[0].id;
    }

    /* 兼容旧版 */
    try {
      var oldRaw = localStorage.getItem('jp-listening-trainer-v24') ||
                   localStorage.getItem('jp-listening-trainer-v23') ||
                   localStorage.getItem('jp-listening-trainer-v22') ||
                   localStorage.getItem('jp-listening-trainer-v21');
      if (oldRaw) {
        var old = JSON.parse(oldRaw);
        if (old && Array.isArray(old.questions) && old.questions.length && !currentHw().questions.length) {
          var hw2 = currentHw();
          hw2.sourceText = old.sourceText || '';
          hw2.questions = old.questions;
          hw2.currentIndex = old.currentIndex || 0;
          if (old.ttsRate) state.ttsRate = old.ttsRate;
          if (old.femaleVoice) state.femaleVoice = old.femaleVoice;
          if (old.maleVoice) state.maleVoice = old.maleVoice;
          if (old.femalePitch) state.femalePitch = old.femalePitch;
          if (old.malePitch) state.malePitch = old.malePitch;
        }
      }
    } catch (e) {}
  }

  /* 恢复界面 */
  if (state.femalePitch) $('#femalePitch').value = state.femalePitch;
  if (state.malePitch) $('#malePitch').value = state.malePitch;
  $('#femalePitchVal').textContent = Number($('#femalePitch').value).toFixed(2);
  $('#malePitchVal').textContent = Number($('#malePitch').value).toFixed(2);

  var hw = currentHw();
  if (hw) {
    if (!Array.isArray(hw.questions)) hw.questions = [];
    if (typeof hw.currentIndex !== 'number') hw.currentIndex = 0;
    if (hw.currentIndex >= hw.questions.length) hw.currentIndex = 0;
    if (!state.view) state.view = hw.questions.length ? 'questions' : 'input';
  }

  renderHwSelect();
  initVoices();
  bindEvents();
  renderAll();
  updatePlayBtn();
  if (!state.readonly) save();
}

init();
</script>
</body>
</html>
