      showToast('倍速：' + opt.label);
    });
    box.appendChild(b);
  });
}

/* ==================== 语音合成（只使用真人级语音） ==================== */
var ttsToken = 0;
var ttsQueue = [];
var ttsIndex = 0;
var ttsPausedChunk = 0;
var ttsState = 'idle';

function ttsSupported() {
  return typeof window.speechSynthesis !== 'undefined' &&
         typeof window.SpeechSynthesisUtterance !== 'undefined';
}

/* ★ 真人级语音的判定：名字里带 online / neural */
function isRealHumanVoice(name) {
  return /online|neural/i.test(name || '');
}

function isRealMaleVoice(name) {
  if (!name) return false;
  if (!isRealHumanVoice(name)) return false;
  return /keita|daichi|naoki|ichiro|yunxi|yunjian/i.test(name);
}

var FEMALE_PREFER = [
  'Microsoft Nanami Online',
  'Microsoft Aoi Online',
  'Microsoft Mayu Online',
  'Microsoft Shiori Online',
  'Microsoft Xiaoxiao Online',
  'Microsoft Xiaoyi Online'
];
var MALE_PREFER = [
  'Microsoft Keita Online',
  'Microsoft Daichi Online',
  'Microsoft Naoki Online',
  'Microsoft Yunxi Online',
  'Microsoft Yunjian Online'
];
var CN_PREFER = [
  'Microsoft Xiaoxiao Online',
  'Microsoft Xiaoyi Online',
  'Microsoft Yunxi Online',
  'Microsoft Yunjian Online'
];

function pickVoiceByName(list, prefers) {
  for (var i = 0; i < prefers.length; i++) {
    for (var j = 0; j < list.length; j++) {
      if (list[j].name.toLowerCase().indexOf(prefers[i].toLowerCase()) >= 0) return list[j];
    }
  }
  return null;
}

function fillVoiceSelects() {
  var all = window.speechSynthesis.getVoices();
  var ja = all.filter(function (v) { return /^ja/i.test(v.lang); });
  /* ★ 只保留真人级语音 */
  var realJa = ja.filter(function (v) { return isRealHumanVoice(v.name); });
  var list = realJa.length ? realJa : [];

  var selF = $('#femaleSel'), selM = $('#maleSel');
  var prevF = selF.value, prevM = selM.value;

  function rebuild(sel, isFemale) {
    sel.innerHTML = '';
    if (!list.length) {
      var o0 = document.createElement('option');
      o0.textContent = '（需使用 Edge 浏览器）';
      sel.appendChild(o0);
      return false;
    }
    list.forEach(function (v) {
      var o = document.createElement('option');
      o.value = v.name;
      o.textContent = v.name + '（' + v.lang + '）';
      sel.appendChild(o);
    });
    return true;
  }
  if (!rebuild(selF, true) || !rebuild(selM, false)) return;

  function exists(name) {
    if (!name) return false;
    for (var i = 0; i < list.length; i++) if (list[i].name === name) return true;
    return false;
  }
  var prefF = state.femaleVoice || prevF;
  if (exists(prefF) && isFemaleVoiceName(prefF)) selF.value = prefF;
  else {
    var vF = pickVoiceByName(list, FEMALE_PREFER);
    if (!vF) {
      /* 找第一个非男性 */
      for (var j = 0; j < list.length; j++) {
        if (!isMaleVoiceName(list[j].name)) { vF = list[j]; break; }
      }
    }
    if (!vF) vF = list[0];
    selF.value = vF.name;
  }
  var prefM = state.maleVoice || prevM;
  if (exists(prefM) && isMaleVoiceName(prefM) && prefM !== selF.value) selM.value = prefM;
  else {
    var vM = null;
    for (var k = 0; k < list.length; k++) {
      if (list[k].name === selF.value) continue;
      if (isMaleVoiceName(list[k].name)) { vM = list[k]; break; }
    }
    if (!vM) {
      for (var m = 0; m < list.length; m++) {
        if (list[m].name !== selF.value) { vM = list[m]; break; }
      }
    }
    if (!vM) vM = list[0];
    selM.value = vM.name;
  }
  if (!state.malePitch) {
    $('#malePitch').value = 1.0;
    $('#malePitchVal').textContent = '1.00';
  }
}

function isMaleVoiceName(name) {
  return /keita|daichi|naoki|ichiro|yunxi|yunjian|male/i.test(name || '');
}
function isFemaleVoiceName(name) {
  return /nanami|aoi|mayu|shiori|xiaoxiao|xiaoyi|female/i.test(name || '');
}

function initVoices() {
